PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

LIBRARY_CATALOG_FILE=./data/library.json
LIBRARY_WRITE_ENABLED=true

# Atualiza as fontes Marvel, DC Comics e Turma da Mônica ao iniciar.
SYNC_PUBLIC_FOLDERS_ON_START=true
PUBLIC_FOLDER_SYNC_COOLDOWN_MS=600000
PUBLIC_FOLDER_TIMEOUT_MS=25000
PUBLIC_FOLDER_CONCURRENCY=4
PUBLIC_FOLDER_MAX_FOLDERS=2000
PUBLIC_FOLDER_MAX_FILES=20000

# Limites de leitura e importação
MAX_COMIC_BYTES=524288000
MAX_ARCHIVE_ENTRY_BYTES=52428800
MAX_ARCHIVE_PAGES=1000
CACHE_TTL_MS=3600000
