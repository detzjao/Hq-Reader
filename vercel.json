{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/content.js": {
      "maxDuration": 300
    },
    "api/archive.js": {
      "maxDuration": 300
    },
    "api/library-import.js": {
      "maxDuration": 300
    },
    "api/library-sync.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/reader/(.*)",
      "destination": "/index.html"
    }
  ]
}
