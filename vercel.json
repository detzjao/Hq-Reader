{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/node-unrar-js/dist/js/unrar.wasm"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin-users",
      "destination": "/api/index?route=admin-users"
    },
    {
      "source": "/api/archive",
      "destination": "/api/index?route=archive"
    },
    {
      "source": "/api/blob-upload",
      "destination": "/api/index?route=blob-upload"
    },
    {
      "source": "/api/comic",
      "destination": "/api/index?route=comic"
    },
    {
      "source": "/api/comics",
      "destination": "/api/index?route=comics"
    },
    {
      "source": "/api/content",
      "destination": "/api/index?route=content"
    },
    {
      "source": "/api/download",
      "destination": "/api/index?route=download"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api/library-add",
      "destination": "/api/index?route=library-add"
    },
    {
      "source": "/api/library-delete",
      "destination": "/api/index?route=library-delete"
    },
    {
      "source": "/api/library-import",
      "destination": "/api/index?route=library-import"
    },
    {
      "source": "/api/library-upload-meta",
      "destination": "/api/index?route=library-upload-meta"
    },
    {
      "source": "/api/library",
      "destination": "/api/index?route=library"
    },
    {
      "source": "/api/user-state",
      "destination": "/api/index?route=user-state"
    },
    {
      "source": "/api/supabase-health",
      "destination": "/api/index?route=supabase-health"
    },
    {
      "source": "/api/supabase-migrate",
      "destination": "/api/index?route=supabase-migrate"
    },
    {
      "source": "/api/drive-sync",
      "destination": "/api/index?route=drive-sync"
    },
    {
      "source": "/api/diagnostics",
      "destination": "/api/index?route=diagnostics"
    },
    {
      "source": "/reader/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/local",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/comic/(.*)",
      "destination": "/index.html"
    }
  ]
}
