{
  "name": "hq-reader-vercel",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace hq-reader-frontend",
    "dev": "npm run dev --workspace hq-reader-frontend",
    "start": "npm run dev --workspace hq-reader-frontend",
