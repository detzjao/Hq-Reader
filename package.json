    "@vercel/blob": "^2.8.0",
    "adm-zip": "^0.5.16",
    "node-unrar-js": "^2.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}