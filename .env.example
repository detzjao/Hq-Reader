# Vercel Blob (recomendado: conexão OIDC atual da Vercel).
# Ao conectar um Blob Store ao projeto, a Vercel adiciona BLOB_STORE_ID
# e fornece autenticação OIDC automaticamente nas Functions.
BLOB_STORE_ID=

# Compatibilidade com lojas antigas / desenvolvimento local. Opcional quando
# BLOB_STORE_ID + OIDC estiverem ativos no projeto.
BLOB_READ_WRITE_TOKEN=

# Senha administrativa do HQ Reader.
HQ_READER_ADMIN_TOKEN=@detzjao1

# Limites opcionais
MAX_UPLOAD_BYTES=524288000
MAX_ARCHIVE_BYTES=314572800
MAX_ARCHIVE_PAGES=1200
CATALOG_CACHE_MS=20000
