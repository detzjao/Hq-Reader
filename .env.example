# Criado automaticamente pela Vercel ao conectar Storage > Blob.
BLOB_READ_WRITE_TOKEN=

# Escolha uma senha sua. Ela protege upload, exclusão e alteração do catálogo.
HQ_READER_ADMIN_TOKEN=troque-por-uma-senha-forte

# Limites opcionais
MAX_UPLOAD_BYTES=524288000
MAX_ARCHIVE_BYTES=314572800
MAX_ARCHIVE_PAGES=1200
CATALOG_CACHE_MS=20000
