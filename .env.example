# ==========================================================
# SUPABASE - mesmo projeto usado pelo HQ Reader
# ==========================================================
# URL e publishable key podem ser expostas no frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Chave SECRET/server-side. NUNCA use VITE_ neste valor e nunca exponha no browser.
# Aceita a sb_secret_ atual ou a service_role legada.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite precisa das variáveis públicas com prefixo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# ==========================================================
# GOOGLE DRIVE API - RECOMENDADO PARA VARREDURA COMPLETA
# ==========================================================
# Crie uma API key no Google Cloud com a Google Drive API habilitada.
# Ela permite listar pastas publicas com paginacao oficial, sem depender
# do HTML do Drive. Sem esta chave, o catalogo seed continua funcionando,
# mas a sincronizacao completa fica indisponivel.
GOOGLE_DRIVE_API_KEY=
DRIVE_SYNC_FOLDERS_PER_PASS=60
DRIVE_SYNC_FILES_PER_PASS=10000
GOOGLE_DRIVE_API_TIMEOUT_MS=30000

# ==========================================================
# API local usada durante npm run dev
# ==========================================================
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8788

# ==========================================================
# Vercel Blob - opcional / legado para uploads manuais
# ==========================================================
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# ==========================================================
# Cache de páginas CBZ/CBR no Supabase Storage
# Opcional. Os arquivos originais do Drive NÃO são copiados para o Supabase.
# ==========================================================
MAX_ARCHIVE_BYTES=314572800
MAX_ARCHIVE_PAGES=1200
SUPABASE_ARCHIVE_BUCKET=comic-pages
SUPABASE_ARCHIVE_PAGE_LIMIT=26214400
